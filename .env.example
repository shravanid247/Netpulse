# Backend database; SQLite works on Windows, PostgreSQL is recommended for Linux deployment
DATABASE_URL=sqlite:///./backend/netpulse.db

# Frontend origin allowed by FastAPI
CORS_ORIGIN=http://127.0.0.1:3000

# Set to real when Linux Mininet/iperf3/aioquic runners are wired in
NETPULSE_EXECUTION_MODE=simulation
